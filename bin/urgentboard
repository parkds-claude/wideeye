#!/bin/sh
# 긴급현황판 관리 명령 — tools/ub.py 를 코드 폴더의 가상 환경으로 부른다. 다른 곳에 링크해 두어도 된다.
#   urgentboard install | uninstall | start|stop|restart [engine|menubar|display|all] | status | doctor [--bundle f.zip] | migrate … | open [setup|settings|list|board]
#   urgentboard setup <명령> …   AI 와 함께 설정(차례: urgentboard setup guide)
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
DIR="$(cd "$(dirname "$SELF")/.." && pwd)" || exit 1
PY="$DIR/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "가상 환경이 없다 — 먼저 $DIR/install.sh" >&2
  exit 1
fi
exec "$PY" "$DIR/tools/ub.py" "$@"
